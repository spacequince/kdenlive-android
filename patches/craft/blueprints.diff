diff --git a/libs/ffmpeg/ffmpeg.py b/libs/ffmpeg/ffmpeg.py
index dcb50275c..be31283d8 100644
--- a/libs/ffmpeg/ffmpeg.py
+++ b/libs/ffmpeg/ffmpeg.py
@@ -55,6 +55,9 @@ class subinfo(info.infoclass):
         self.runtimeDependencies["virtual/base"] = None
         self.runtimeDependencies["libs/zlib"] = None
         self.runtimeDependencies["libs/openssl"] = None
+        if CraftCore.compiler.isAndroid:
+            # ANDROID_X264: software H.264 encoding for the Kdenlive Android port
+            self.runtimeDependencies["libs/x264"] = None
         if not CraftCore.compiler.isAndroid:
             self.runtimeDependencies["libs/liblame"] = None
             self.runtimeDependencies["libs/libopus"] = None
@@ -104,7 +107,8 @@ class Package(AutoToolsPackageBase):
         if not CraftCore.compiler.isAndroid:
             self.subinfo.options.configure.args += ["--enable-libmp3lame", "--enable-libass", "--enable-libvpx"]
         else:
-            self.subinfo.options.configure.args += ["--disable-programs"]
+            # ANDROID_PROGRAMS: ffmpeg + ffprobe command line tools are shipped as libffmpeg.so/libffprobe.so executables (Kdenlive spawns them)
+            self.subinfo.options.configure.args += ["--enable-ffmpeg", "--enable-ffprobe", "--disable-ffplay"]
         if "CC" in os.environ:
             cc = os.environ["CC"]
             if CraftCore.compiler.isMacOS and not CraftCore.compiler.isNative():
@@ -178,6 +182,9 @@ class Package(AutoToolsPackageBase):
             ]
 
         if CraftCore.compiler.isAndroid:
+            self.subinfo.options.configure.args += ["--enable-libx264", "--pkg-config=/usr/bin/pkg-config"]  # ANDROID_X264
+            # hardware encoding/decoding through Android's MediaCodec (needs JNI)  # ANDROID_MEDIACODEC
+            self.subinfo.options.configure.args += ["--enable-jni", "--enable-mediacodec"]
             # Work around https://github.com/android/ndk/issues/1974 in ndk26.
             # But also Vulkan video decode isn't well supported on Android anyway.
             self.subinfo.options.configure.args += ["--disable-vulkan"]
@@ -228,5 +235,9 @@ class Package(AutoToolsPackageBase):
                 "INCLUDE": f"{os.environ['INCLUDE']};{CraftStandardDirs.craftRoot() / 'include'}",
             }
         if CraftCore.compiler.isAndroid:
-            return {"PATH": os.pathsep.join([self._ndkToolchainPath, os.environ["PATH"]])}
+            # ANDROID_X264: FFmpeg's cross build falls back to "false" as pkg-config; use the host one with Craft's .pc files
+            return {
+                "PATH": os.pathsep.join([self._ndkToolchainPath, os.environ["PATH"]]),
+                "PKG_CONFIG_LIBDIR": str(CraftStandardDirs.craftRoot() / "lib" / "pkgconfig"),
+            }
         return {}
