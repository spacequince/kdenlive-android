+#pragma once
+
+#include <QtGlobal>
+
+#ifdef Q_OS_ANDROID
+/** @brief Developer check: when <external files>/selftest.txt exists, render a test pattern with the filters listed in it
+ *  (one MLT service per line, e.g. frei0r.invert0r) to PNG files next to it. */
+void androidDevSelfTest();
+#include <QObject>
+#include <QString>
+#include <atomic>
+
+/** @brief Renders a Kdenlive playlist (MLT XML with an embedded consumer) inside the app process.
+ *  Android cannot run the separate melt / kdenlive_render programs, so this replaces them.
+ *  Signals use the same meaning as the render server messages. */
+class AndroidRender : public QObject
+{
+    Q_OBJECT
+public:
+    static AndroidRender *instance();
+    /** @brief Start rendering @param playlist in a worker thread. */
+    void start(const QString &playlist);
+    /** @brief Abort the job writing @param url (the output file). */
+    void abort(const QString &url);
+    void abortAll();
+
+Q_SIGNALS:
+    void progress(const QString &url, int percent, int frame);
+    void finished(const QString &url, int status, const QString &error);
+
+private:
+    explicit AndroidRender(QObject *parent = nullptr);
+    void run(const QString &playlist);
+    std::atomic<bool> m_abort{false};
+    QString m_runningUrl;
+};
+#endif
