@@ -0,0 +1,398 @@
+/*
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "androidsetup.h"
+
+#include "core.h"
+#include "doc/kdenlivedoc.h"
+#include "kdenlivesettings.h"
+#include "project/projectmanager.h"
+
+#include <QGuiApplication>
+
+#include <QCoreApplication>
+#include <QDebug>
+#include <QDir>
+#include <QDirIterator>
+#include <QFileInfo>
+#include <QFile>
+#include <QJniEnvironment>
+#include <QJniObject>
+#include <QIcon>
+#include <QMimeDatabase>
+#include <QResource>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <QStandardPaths>
+#include <QUrl>
+
+static void copyAssetDir(const QString &src, const QString &dst)
+{
+    QDir().mkpath(dst);
+    const QString prefix = src + QLatin1Char('/');
+    QDirIterator it(src, QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot, QDirIterator::Subdirectories);
+    while (it.hasNext()) {
+        const QString path = it.next();
+        const QString target = dst + QLatin1Char('/') + path.mid(prefix.length());
+        if (it.fileInfo().isDir()) {
+            QDir().mkpath(target);
+        } else {
+            QDir().mkpath(QFileInfo(target).absolutePath());
+            QFile::remove(target);
+            if (!QFile::copy(path, target)) {
+                qWarning() << "Android: failed to copy asset" << path << "to" << target;
+            } else {
+                QFile::setPermissions(target, QFile::permissions(target) | QFileDevice::WriteOwner);
+            }
+        }
+    }
+}
+
+QString androidNativeLibDir()
+{
+    return QString::fromUtf8(qgetenv("KDENLIVE_NATIVE_LIB_DIR"));
+}
+
+void androidPrepareData()
+{
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+    QString nativeDir;
+    qint64 updateTime = 0;
+    if (ctx.isValid()) {
+        QJniObject appInfo = ctx.callObjectMethod("getApplicationInfo", "()Landroid/content/pm/ApplicationInfo;");
+        nativeDir = appInfo.getObjectField<jstring>("nativeLibraryDir").toString();
+        QJniObject pm = ctx.callObjectMethod("getPackageManager", "()Landroid/content/pm/PackageManager;");
+        QJniObject pkg = ctx.callObjectMethod("getPackageName", "()Ljava/lang/String;");
+        QJniObject pi = pm.callObjectMethod("getPackageInfo", "(Ljava/lang/String;I)Landroid/content/pm/PackageInfo;", pkg.object<jstring>(), 0);
+        updateTime = pi.getField<jlong>("lastUpdateTime");
+    }
+    const QString base = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    QDir().mkpath(base);
+
+    const QString marker = base + QStringLiteral("/.assets-version");
+    QString current;
+    QFile mf(marker);
+    if (mf.open(QIODevice::ReadOnly)) {
+        current = QString::fromUtf8(mf.readAll()).trimmed();
+        mf.close();
+    }
+    const QString wanted = QString::number(updateTime);
+    if (current != wanted) {
+        qDebug() << "Android: installing bundled data to" << base;
+        copyAssetDir(QStringLiteral("assets:/mlt"), base + QStringLiteral("/mlt"));
+        copyAssetDir(QStringLiteral("assets:/kdenlive"), base);
+        copyAssetDir(QStringLiteral("assets:/icons"), base + QStringLiteral("/icons"));
+        if (mf.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            mf.write(wanted.toUtf8());
+            mf.close();
+        }
+    }
+
+    // Breeze icon theme, bundled as a Qt resource file
+    if (QResource::registerResource(base + QStringLiteral("/icons/breeze-icons.rcc"))) {
+        QIcon::setThemeSearchPaths(QStringList{QStringLiteral(":/icons")} + QIcon::themeSearchPaths());
+        QIcon::setThemeName(QStringLiteral("breeze-dark"));
+        QIcon::setFallbackThemeName(QStringLiteral("breeze-dark"));
+    } else {
+        qWarning() << "Android: could not register the icon theme";
+    }
+    // (MLT is patched to only try libmlt*.so modules in the native library directory)
+    qputenv("MLT_REPOSITORY", nativeDir.toUtf8());
+    qputenv("KDENLIVE_NATIVE_LIB_DIR", nativeDir.toUtf8());
+    qputenv("MLT_DATA", (base + QStringLiteral("/mlt")).toUtf8());
+    qputenv("MLT_PROFILES_PATH", (base + QStringLiteral("/mlt/profiles")).toUtf8());
+    qputenv("FREI0R_PATH", nativeDir.toUtf8());
+    qputenv("LADSPA_PATH", nativeDir.toUtf8());
+    qDebug() << "Android: native lib dir" << nativeDir << "data dir" << base;
+}
+
+static const char *const s_mediaPermissions[] = {"android.permission.READ_MEDIA_VIDEO",
+                                                 "android.permission.READ_MEDIA_IMAGES",
+                                                 "android.permission.READ_MEDIA_AUDIO",
+                                                 "android.permission.POST_NOTIFICATIONS"};
+
+static bool androidHasPermission(const QJniObject &ctx, const char *permission)
+{
+    return ctx.callMethod<jint>("checkSelfPermission", "(Ljava/lang/String;)I", QJniObject::fromString(QLatin1String(permission)).object<jstring>()) == 0;
+}
+
+void androidRequestMediaPermissions()
+{
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+    if (!ctx.isValid()) {
+        return;
+    }
+    QStringList missing;
+    for (const char *permission : s_mediaPermissions) {
+        if (!androidHasPermission(ctx, permission)) {
+            missing << QLatin1String(permission);
+        }
+    }
+    if (missing.isEmpty()) {
+        return;
+    }
+    QNativeInterface::QAndroidApplication::runOnAndroidMainThread([ctx, missing]() {
+        QJniEnvironment env;
+        jclass stringClass = env->FindClass("java/lang/String");
+        jobjectArray array = env->NewObjectArray(missing.size(), stringClass, nullptr);
+        for (int i = 0; i < missing.size(); ++i) {
+            env->SetObjectArrayElement(array, i, QJniObject::fromString(missing.at(i)).object<jstring>());
+        }
+        QJniObject activity = ctx;
+        activity.callMethod<void>("requestPermissions", "([Ljava/lang/String;I)V", array, 7001);
+        env->DeleteLocalRef(array);
+        env->DeleteLocalRef(stringClass);
+    });
+}
+
+/** Returns the real file path behind a document picked with the system picker, if the app can read it directly. */
+static QString androidContentToLocalPath(const QUrl &url)
+{
+    const QString authority = url.authority();
+    const QString docPath = QUrl::fromPercentEncoding(url.path().toUtf8()); // "/document/video:1000012179"
+    QString candidate;
+    QString mediaUri;
+    if (authority == QLatin1String("com.android.externalstorage.documents")) {
+        const QString id = docPath.section(QLatin1Char('/'), 2);
+        if (id.startsWith(QLatin1String("primary:"))) {
+            candidate = QStringLiteral("/storage/emulated/0/") + id.mid(8);
+        }
+    } else if (authority == QLatin1String("com.android.providers.media.documents")) {
+        const QString id = docPath.section(QLatin1Char('/'), 2);
+        const QString type = id.section(QLatin1Char(':'), 0, 0);
+        const QString number = id.section(QLatin1Char(':'), 1);
+        if (type == QLatin1String("video") || type == QLatin1String("audio") || type == QLatin1String("image")) {
+            mediaUri = QStringLiteral("content://media/external/%1/media/%2").arg(type, number);
+        }
+    } else if (authority == QLatin1String("media")) {
+        mediaUri = url.toString();
+    }
+
+    if (!mediaUri.isEmpty()) {
+        QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+        QJniObject resolver = ctx.callObjectMethod("getContentResolver", "()Landroid/content/ContentResolver;");
+        QJniObject uri = QJniObject::callStaticObjectMethod("android/net/Uri",
+                                                            "parse",
+                                                            "(Ljava/lang/String;)Landroid/net/Uri;",
+                                                            QJniObject::fromString(mediaUri).object<jstring>());
+        QJniEnvironment env;
+        jclass stringClass = env->FindClass("java/lang/String");
+        jobjectArray projection = env->NewObjectArray(1, stringClass, nullptr);
+        env->SetObjectArrayElement(projection, 0, QJniObject::fromString(QStringLiteral("_data")).object<jstring>());
+        QJniObject cursor = resolver.callObjectMethod("query",
+                                                      "(Landroid/net/Uri;[Ljava/lang/String;Ljava/lang/String;[Ljava/lang/String;Ljava/lang/String;)Landroid/database/Cursor;",
+                                                      uri.object(),
+                                                      projection,
+                                                      nullptr,
+                                                      nullptr,
+                                                      nullptr);
+        env->DeleteLocalRef(projection);
+        env->DeleteLocalRef(stringClass);
+        if (cursor.isValid()) {
+            if (cursor.callMethod<jboolean>("moveToFirst")) {
+                candidate = cursor.callObjectMethod("getString", "(I)Ljava/lang/String;", 0).toString();
+            }
+            cursor.callMethod<void>("close");
+        }
+    }
+    if (!candidate.isEmpty() && QFileInfo(candidate).isReadable()) {
+        return candidate;
+    }
+    return {};
+}
+
+QList<QUrl> androidImportUrls(const QList<QUrl> &urls, const QString &subdir)
+{
+    QList<QUrl> result;
+    const QString mediaDir = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + QLatin1Char('/') + subdir;
+    for (const QUrl &url : urls) {
+        if (url.scheme() != QLatin1String("content")) {
+            result << url;
+            continue;
+        }
+        if (subdir == QLatin1String("media")) {
+            // use the original file in place when the app is allowed to read it (no copy)
+            const QString direct = androidContentToLocalPath(url);
+            if (!direct.isEmpty()) {
+                qDebug() << "Android: using" << url << "in place as" << direct;
+                result << QUrl::fromLocalFile(direct);
+                continue;
+            }
+            androidRequestMediaPermissions();
+        }
+        QDir().mkpath(mediaDir);
+        QFile src(url.toString());
+        QString name = QFileInfo(url.toString()).fileName();
+        if (name.isEmpty()) {
+            name = url.fileName();
+        }
+        if (name.isEmpty()) {
+            name = QStringLiteral("imported");
+        }
+        QString dest = mediaDir + QLatin1Char('/') + name;
+        // avoid overwriting a different file that has the same name
+        const qint64 size = src.size();
+        const QFileInfo base(name);
+        int n = 1;
+        while (QFileInfo::exists(dest) && QFileInfo(dest).size() != size) {
+            dest = mediaDir + QLatin1Char('/') + base.completeBaseName() + QStringLiteral("_%1.").arg(n++) + base.suffix();
+        }
+        if (!QFileInfo::exists(dest)) {
+            if (!src.copy(dest)) {
+                qWarning() << "Android: could not import" << url << ":" << src.errorString();
+                continue;
+            }
+        }
+        qDebug() << "Android: imported" << url << "->" << dest;
+        result << QUrl::fromLocalFile(dest);
+    }
+    return result;
+}
+
+void androidInitFFmpeg()
+{
+    void *lib = dlopen("libavcodec.so", RTLD_NOW);
+    if (!lib) {
+        qWarning() << "Android: libavcodec not found:" << dlerror();
+        return;
+    }
+    using SetJavaVm = int (*)(void *, void *);
+    auto setJavaVm = reinterpret_cast<SetJavaVm>(dlsym(lib, "av_jni_set_java_vm"));
+    if (setJavaVm) {
+        const int r = setJavaVm(QJniEnvironment::javaVM(), nullptr);
+        qDebug() << "Android: av_jni_set_java_vm returned" << r;
+    } else {
+        qWarning() << "Android: av_jni_set_java_vm not available";
+    }
+}
+
+QString androidPublishVideo(const QString &path)
+{
+    QFileInfo info(path);
+    if (!info.exists()) {
+        return {};
+    }
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+    if (!ctx.isValid()) {
+        return {};
+    }
+    QString mime = QMimeDatabase().mimeTypeForFile(info).name();
+    if (!mime.startsWith(QLatin1String("video/")) && !mime.startsWith(QLatin1String("audio/"))) {
+        mime = QStringLiteral("video/mp4");
+    }
+    const bool isAudio = mime.startsWith(QLatin1String("audio/"));
+
+    QJniObject resolver = ctx.callObjectMethod("getContentResolver", "()Landroid/content/ContentResolver;");
+    QJniObject values("android/content/ContentValues");
+    auto put = [&values](const char *key, const QString &value) {
+        values.callMethod<void>("put",
+                                "(Ljava/lang/String;Ljava/lang/String;)V",
+                                QJniObject::fromString(QLatin1String(key)).object<jstring>(),
+                                QJniObject::fromString(value).object<jstring>());
+    };
+    put("_display_name", info.fileName());
+    put("mime_type", mime);
+    put("relative_path", isAudio ? QStringLiteral("Music/Kdenlive") : QStringLiteral("Movies/Kdenlive"));
+
+    QJniObject collection = QJniObject::callStaticObjectMethod(isAudio ? "android/provider/MediaStore$Audio$Media" : "android/provider/MediaStore$Video$Media",
+                                                               "getContentUri",
+                                                               "(Ljava/lang/String;)Landroid/net/Uri;",
+                                                               QJniObject::fromString(QStringLiteral("external_primary")).object<jstring>());
+    QJniObject uri = resolver.callObjectMethod("insert",
+                                               "(Landroid/net/Uri;Landroid/content/ContentValues;)Landroid/net/Uri;",
+                                               collection.object(),
+                                               values.object());
+    if (!uri.isValid()) {
+        qWarning() << "Android: MediaStore insert failed for" << path;
+        return {};
+    }
+    const QString uriString = uri.toString();
+    QFile src(path);
+    if (!src.open(QIODevice::ReadOnly)) {
+        qWarning() << "Android: cannot read" << path << src.errorString();
+        return {};
+    }
+    // QFile cannot write to content:// URIs: write through a file descriptor from the content resolver
+    QJniObject pfd = resolver.callObjectMethod("openFileDescriptor",
+                                               "(Landroid/net/Uri;Ljava/lang/String;)Landroid/os/ParcelFileDescriptor;",
+                                               uri.object(),
+                                               QJniObject::fromString(QStringLiteral("w")).object<jstring>());
+    if (!pfd.isValid()) {
+        qWarning() << "Android: cannot open output descriptor for" << uriString;
+        return {};
+    }
+    const int fd = pfd.callMethod<jint>("detachFd");
+    QByteArray buffer(1 << 20, Qt::Uninitialized);
+    bool ok = true;
+    while (ok) {
+        const qint64 n = src.read(buffer.data(), buffer.size());
+        if (n <= 0) {
+            break;
+        }
+        qint64 written = 0;
+        while (written < n) {
+            const ssize_t w = ::write(fd, buffer.constData() + written, n - written);
+            if (w <= 0) {
+                ok = false;
+                break;
+            }
+            written += w;
+        }
+    }
+    ::close(fd);
+    if (!ok) {
+        qWarning() << "Android: write error while publishing" << path;
+        return {};
+    }
+    qDebug() << "Android: published" << path << "as" << uriString;
+    return uriString;
+}
+
+void androidInstallLifecycleHooks()
+{
+    // Android ends background apps without warning: save as soon as the activity is stopped.
+    QObject::connect(qApp, &QGuiApplication::applicationStateChanged, qApp, [](Qt::ApplicationState state) {
+        if (state != Qt::ApplicationSuspended && state != Qt::ApplicationHidden) {
+            return;
+        }
+        if (pCore && pCore->currentDoc() && pCore->currentDoc()->isModified() && pCore->projectManager()) {
+            qDebug() << "Android: app went to the background, saving the project";
+            pCore->projectManager()->saveFile();
+        }
+    });
+}
+
+static QJniObject androidContext()
+{
+    return QNativeInterface::QAndroidApplication::context();
+}
+
+void androidRenderServiceStart(const QString &title)
+{
+    QJniObject ctx = androidContext();
+    QJniObject::callStaticMethod<void>("org/kdenlive/android/RenderService", "start", "(Landroid/content/Context;Ljava/lang/String;)V", ctx.object(),
+                                       QJniObject::fromString(title).object<jstring>());
+}
+
+void androidRenderServiceProgress(const QString &title, int percent)
+{
+    QJniObject ctx = androidContext();
+    QJniObject::callStaticMethod<void>("org/kdenlive/android/RenderService", "update", "(Landroid/content/Context;Ljava/lang/String;I)V", ctx.object(),
+                                       QJniObject::fromString(title).object<jstring>(), jint(percent));
+}
+
+void androidRenderServiceStop()
+{
+    QJniObject ctx = androidContext();
+    QJniObject::callStaticMethod<void>("org/kdenlive/android/RenderService", "stop", "(Landroid/content/Context;)V", ctx.object());
+}
+
+void androidRenderServiceFinished(const QString &contentUri, const QString &title, bool ok, const QString &message)
+{
+    QJniObject ctx = androidContext();
+    QJniObject::callStaticMethod<void>("org/kdenlive/android/RenderService", "finished",
+                                       "(Landroid/content/Context;Ljava/lang/String;Ljava/lang/String;ZLjava/lang/String;)V", ctx.object(),
+                                       QJniObject::fromString(contentUri).object<jstring>(), QJniObject::fromString(title).object<jstring>(), jboolean(ok),
+                                       QJniObject::fromString(message).object<jstring>());
+}
