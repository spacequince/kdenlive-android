+
+class AndroidUiHelper : public QObject
+{
+public:
+    explicit AndroidUiHelper(QObject *parent)
+        : QObject(parent)
+    {
+        // Qt for Android drops mouse input for dialog windows: tell KdenliveActivity to convert mouse events to touch while one is open
+        m_dialogTimer.setInterval(120);
+        connect(&m_dialogTimer, &QTimer::timeout, this, [this]() {
+            bool dialogOpen = false;
+            const QWidgetList tops = QApplication::topLevelWidgets();
+            for (QWidget *w : tops) {
+                if (w->isVisible() && qobject_cast<QDialog *>(w)) {
+                    dialogOpen = true;
+                    break;
+                }
+            }
+            if (dialogOpen != m_dialogOpen) {
+                m_dialogOpen = dialogOpen;
+                QJniObject::setStaticField<jboolean>("org/kdenlive/android/KdenliveActivity", "mouseAsTouch", jboolean(dialogOpen));
+            }
+        });
+        m_dialogTimer.start();
+        m_longPressTimer.setSingleShot(true);
+        m_longPressTimer.setInterval(600);
+        connect(&m_longPressTimer, &QTimer::timeout, this, &AndroidUiHelper::longPress);
+    }
+
+    bool eventFilter(QObject *obj, QEvent *event) override
+    {
+        switch (event->type()) {
+        case QEvent::Show:
+            if (auto *w = qobject_cast<QWidget *>(obj)) {
+                decorate(w);
+            }
+            break;
+        case QEvent::FocusIn:
+            // The Android keyboard's predictive text keeps an in-progress word (composing region) that Qt's validators / spin boxes / rich text
+            // editors reject or rewrite: text then gets deleted irreversibly and typing stops working. Ask the keyboard for plain key input.
+            if (auto *w = qobject_cast<QWidget *>(obj)) {
+                if (qobject_cast<QLineEdit *>(w) || qobject_cast<QAbstractSpinBox *>(w) || qobject_cast<QTextEdit *>(w) || qobject_cast<QPlainTextEdit *>(w)) {
+                    const Qt::InputMethodHints wanted = Qt::ImhNoPredictiveText | Qt::ImhNoAutoUppercase;
+                    if ((w->inputMethodHints() & wanted) != wanted) {
+                        w->setInputMethodHints(w->inputMethodHints() | wanted);
+                        QGuiApplication::inputMethod()->update(Qt::ImHints);
+                    }
+                }
+            }
+            break;
+        case QEvent::MouseButtonPress:
+        case QEvent::MouseMove:
+        case QEvent::MouseButtonRelease:
+            logMouse(obj, static_cast<QMouseEvent *>(event));
+            return handleMouse(obj, static_cast<QMouseEvent *>(event));
+        default:
+            break;
+        }
+        return false;
+    }
+
+private:
+    /** Border for every top-level popup/dialog (not the main window) */
+    void decorate(QWidget *w)
+    {
+        if (!w->isWindow() || w->property("androidBorder").toBool()) {
+            return;
+        }
+        const Qt::WindowType type = w->windowType();
+        if (type != Qt::Dialog && type != Qt::Popup && type != Qt::Tool && type != Qt::Sheet && type != Qt::Drawer) {
+            return;
+        }
+        w->setProperty("androidBorder", true);
+        if (w->objectName().isEmpty()) {
+            w->setObjectName(QStringLiteral("androidWindow%1").arg(quintptr(w), 0, 16));
+        }
+        w->setStyleSheet(w->styleSheet() + QStringLiteral("\n#%1 { border: 2px solid %2; }").arg(w->objectName(), QLatin1String(s_borderColor)));
+    }
+
+    /** Developer aid for automated mouse tests: when <external files>/mouselog.txt exists, log real mouse events
+     *  (device pixel coordinates) so that a script can steer a virtual mouse precisely. */
+    void logMouse(QObject *obj, QMouseEvent *me)
+    {
+        static const bool enabled = QFile::exists(QStringLiteral("/storage/emulated/0/Android/data/org.qtproject.example.kdenlive/files/mouselog.txt"));
+        if (!enabled || me->source() != Qt::MouseEventNotSynthesized || !qobject_cast<QWidget *>(obj)) {
+            return;
+        }
+        static QPointF last;
+        const QPointF g = me->globalPosition() * qApp->devicePixelRatio();
+        if (me->type() == QEvent::MouseMove && (g - last).manhattanLength() < 0.5) {
+            return;
+        }
+        last = g;
+        qWarning().nospace() << "MOUSEPOS " << int(me->type()) << " " << qRound(g.x()) << " " << qRound(g.y()) << " b" << int(me->button()) << " B" << int(me->buttons())
+                             << " " << obj->metaObject()->className();
+    }
+
+    /** Long press (finger down 600 ms without moving) = right click.
+     *  Touch is delivered to widgets as synthesized left mouse events. */
+    bool handleMouse(QObject *obj, QMouseEvent *me)
+    {
+        const bool synthesized = me->source() != Qt::MouseEventNotSynthesized;
+        if (!synthesized) {
+            return false;
+        }
+        auto *widget = qobject_cast<QWidget *>(obj);
+        if (!widget) {
+            return false;
+        }
+        switch (me->type()) {
+        case QEvent::MouseButtonPress:
+            if (me->button() == Qt::LeftButton && me->buttons() == Qt::LeftButton) {
+                m_target = widget;
+                m_pressGlobal = me->globalPosition();
+                m_pressLocal = me->position();
+                m_fired = false;
+                m_longPressTimer.start();
+            }
+            break;
+        case QEvent::MouseMove:
+            if (m_longPressTimer.isActive() && (me->globalPosition() - m_pressGlobal).manhattanLength() > 24) {
+                m_longPressTimer.stop();
+            }
+            break;
+        case QEvent::MouseButtonRelease:
+            m_longPressTimer.stop();
+            if (m_fired) {
+                m_fired = false;
+                return true; // the right click was already sent, swallow the real release
+            }
+            break;
+        default:
+            break;
+        }
+        return false;
+    }
+
+    void longPress()
+    {
+        QWidget *target = m_target;
+        if (!target) {
+            return;
+        }
+        m_fired = true;
+        // cancel the left press (so no drag/selection continues), then send a right click
+        QMouseEvent leftRelease(QEvent::MouseButtonRelease, m_pressLocal, m_pressGlobal, Qt::LeftButton, Qt::NoButton, Qt::NoModifier);
+        QMouseEvent rightPress(QEvent::MouseButtonPress, m_pressLocal, m_pressGlobal, Qt::RightButton, Qt::RightButton, Qt::NoModifier);
+        QMouseEvent rightRelease(QEvent::MouseButtonRelease, m_pressLocal, m_pressGlobal, Qt::RightButton, Qt::NoButton, Qt::NoModifier);
+        QContextMenuEvent context(QContextMenuEvent::Mouse, m_pressLocal.toPoint(), m_pressGlobal.toPoint());
+        QApplication::sendEvent(target, &leftRelease);
+        QApplication::sendEvent(target, &rightPress);
+        QApplication::sendEvent(target, &rightRelease);
+        QApplication::sendEvent(target, &context);
+    }
+
+    QTimer m_longPressTimer;
+    QTimer m_dialogTimer;
+    bool m_dialogOpen = false;
+    QPointer<QWidget> m_target;
+    QPointF m_pressGlobal;
+    QPointF m_pressLocal;
+    bool m_fired = false;
+};
+} // namespace
+
+void androidInstallUiHelpers()
+{
+    static AndroidUiHelper *helper = new AndroidUiHelper(qApp);
+    qApp->installEventFilter(helper);
+}
