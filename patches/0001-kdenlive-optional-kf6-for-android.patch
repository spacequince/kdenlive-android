index 0000000..8193fa3
--- /dev/null
+++ b/src/android/androidrender.cpp
@@ -0,0 +1,256 @@
+/*
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "androidrender.h"
+
+#include <QDebug>
+#include <QDomDocument>
+#include <QFile>
+#include <QFileInfo>
+#include <QProcess>
+#include <QThread>
+
+#include "androidsetup.h"
+
+#include <mlt++/Mlt.h>
+
+#include <dlfcn.h>
+extern "C" {
+#include <libavfilter/avfilter.h>
+}
+
+AndroidRender *AndroidRender::instance()
+{
+    static AndroidRender *s_instance = new AndroidRender();
+    return s_instance;
+}
+
+AndroidRender::AndroidRender(QObject *parent)
+    : QObject(parent)
+{
+}
+
+void AndroidRender::start(const QString &playlist)
+{
+    m_abort = false;
+    QThread *t = QThread::create([this, playlist]() { run(playlist); });
+    connect(t, &QThread::finished, t, &QObject::deleteLater);
+    t->start();
+}
+
+void AndroidRender::abort(const QString &url)
+{
+    if (url == m_runningUrl) {
+        m_abort = true;
+    }
+}
+
+void AndroidRender::abortAll()
+{
+    m_abort = true;
+}
+
+void AndroidRender::run(const QString &playlist)
+{
+    // Same information kdenlive_render reads from the playlist
+    int in = -1;
+    int out = -1;
+    QString target;
+    QFile f(playlist);
+    QDomDocument doc;
+    if (f.open(QIODevice::ReadOnly) && doc.setContent(&f)) {
+        const QDomElement consumer = doc.documentElement().firstChildElement(QStringLiteral("consumer"));
+        if (!consumer.isNull()) {
+            in = consumer.attribute(QStringLiteral("in"), QStringLiteral("-1")).toInt();
+            out = consumer.attribute(QStringLiteral("out"), QStringLiteral("-1")).toInt();
+            target = consumer.attribute(QStringLiteral("target"));
+        }
+    }
+    f.close();
+    m_runningUrl = target;
+    const QString jobTitle = QFileInfo(target).fileName();
+    androidRenderServiceStart(jobTitle);
+    qDebug() << "Android render: playlist" << playlist << "target" << target << "in" << in << "out" << out;
+
+    Mlt::Profile profile;
+    Mlt::Producer producer(profile, "xml", playlist.toUtf8().constData());
+    if (!producer.is_valid()) {
+        androidRenderServiceStop();
+        androidRenderServiceFinished(QString(), jobTitle, false, QStringLiteral("Failed to load the project playlist"));
+        Q_EMIT finished(target, -2, QStringLiteral("Failed to load the project playlist"));
+        return;
+    }
+    // producer_xml keeps the consumer defined in the playlist as the "consumer" data property
+    mlt_consumer consumer = static_cast<mlt_consumer>(mlt_properties_get_data(MLT_PRODUCER_PROPERTIES(producer.get_producer()), "consumer", nullptr));
+    if (consumer == nullptr) {
+        androidRenderServiceStop();
+        androidRenderServiceFinished(QString(), jobTitle, false, QStringLiteral("The playlist does not define an output (consumer)"));
+        Q_EMIT finished(target, -2, QStringLiteral("The playlist does not define an output (consumer)"));
+        return;
+    }
+    mlt_properties props = MLT_CONSUMER_PROPERTIES(consumer);
+    mlt_properties_set_int(props, "terminate_on_pause", 1);
+
+    const int cin = mlt_properties_get_int(props, "in");
+    const int cout = mlt_properties_get_int(props, "out");
+    if (cin > 0 || cout > 0) {
+        mlt_producer_set_in_and_out(producer.get_producer(), cin, cout > 0 ? cout : producer.get_length() - 1);
+        mlt_producer_seek(producer.get_producer(), 0);
+    }
+    const int total = qMax(1, producer.get_playtime());
+
+    mlt_consumer_connect(consumer, producer.get_service());
+    if (mlt_consumer_start(consumer) != 0) {
+        mlt_consumer_connect(consumer, nullptr);
+        androidRenderServiceStop();
+        androidRenderServiceFinished(QString(), jobTitle, false, QStringLiteral("Could not start the encoder"));
+        Q_EMIT finished(target, -2, QStringLiteral("Could not start the encoder"));
+        return;
+    }
+
+    int lastProgress = 0;
+    while (!mlt_consumer_is_stopped(consumer)) {
+        if (m_abort) {
+            break;
+        }
+        const int pos = mlt_consumer_position(consumer);
+        const int percent = qBound(0, pos * 100 / total, 100);
+        if (percent > lastProgress) {
+            lastProgress = percent;
+            Q_EMIT progress(target, percent, pos);
+            androidRenderServiceProgress(jobTitle, percent);
+        }
+        // consumers without terminate_on_pause support: stop once the end is reached
+        if (pos >= total - 1 && pos > 0) {
+            QThread::msleep(500);
+            if (!mlt_consumer_is_stopped(consumer)) {
+                break;
+            }
+        }
+        QThread::msleep(200);
+    }
+    const bool aborted = m_abort;
+    mlt_consumer_stop(consumer);
+    mlt_consumer_connect(consumer, nullptr);
+
+    androidRenderServiceStop();
+    if (aborted) {
+        QFile::remove(target);
+        Q_EMIT finished(target, -3, QString());
+    } else if (!QFileInfo::exists(target) || QFileInfo(target).size() < 1024) {
+        // an empty file means the encoder failed (e.g. unsupported pixel format or codec)
+        QFile::remove(target);
+        androidRenderServiceFinished(QString(), jobTitle, false, QStringLiteral("The encoder failed to produce any video. Try another render preset."));
+        Q_EMIT finished(target, -2, QStringLiteral("The encoder failed to produce any video. Try another render preset."));
+    } else {
+        Q_EMIT progress(target, 100, total);
+        // make the video visible to the gallery / file manager apps (Movies/Kdenlive)
+        const QString contentUri = androidPublishVideo(target);
+        androidRenderServiceFinished(contentUri, jobTitle, true, QString());
+        Q_EMIT finished(target, 0, QString());
+    }
+    m_runningUrl.clear();
+}
+
+void androidDevSelfTest()
+{
+    const QString dir = QStringLiteral("/storage/emulated/0/Android/data/org.qtproject.example.kdenlive/files/");
+    QFile list(dir + QStringLiteral("selftest.txt"));
+    if (!list.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    const QStringList filters = QString::fromUtf8(list.readAll()).split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    list.close();
+    // "av:<name>" lines: report how libavfilter describes a filter (the same test MLT applies before registering it)
+    void *avf = dlopen("libavfilter.so", RTLD_NOW);
+    using GetByName = const AVFilter *(*)(const char *);
+    using PadCount = unsigned (*)(const AVFilter *, int);
+    using PadType = enum AVMediaType (*)(const AVFilterPad *, int);
+    auto getByName = avf ? reinterpret_cast<GetByName>(dlsym(avf, "avfilter_get_by_name")) : nullptr;
+    auto padCount = avf ? reinterpret_cast<PadCount>(dlsym(avf, "avfilter_filter_pad_count")) : nullptr;
+    auto padType = avf ? reinterpret_cast<PadType>(dlsym(avf, "avfilter_pad_get_type")) : nullptr;
+    QStringList mltFilters;
+    for (const QString &line : filters) {
+        if (line.startsWith(QLatin1String("exec:"))) {
+            // exec:<program in native lib dir> <args...>   e.g. exec:libmelt.so -query consumers
+            const QStringList parts = line.mid(5).trimmed().split(QLatin1Char(' '), Qt::SkipEmptyParts);
+            if (parts.isEmpty()) {
+                continue;
+            }
+            const QString program = androidNativeLibDir() + QLatin1Char('/') + parts.first();
+            QProcess process;
+            process.start(program, parts.mid(1));
+            const bool started = process.waitForStarted(5000);
+            const bool finished = started && process.waitForFinished(60000);
+            const QString out = QString::fromUtf8(process.readAllStandardOutput()).left(600).replace(QLatin1Char('\n'), QLatin1Char('|'));
+            QString err = QString::fromUtf8(process.readAllStandardError());
+            err = err.right(700).replace(QLatin1Char('\n'), QLatin1Char('|'));
+            qWarning() << "SELFTEST exec" << program << "started" << started << "finished" << finished << "exit" << process.exitCode() << "status"
+                       << process.exitStatus() << "error" << process.errorString() << "OUT" << out << "ERR" << err;
+            continue;
+        }
+        if (line.startsWith(QLatin1String("meta:"))) {
+            const QString id = line.mid(5).trimmed();
+            Mlt::Repository *repo = Mlt::Factory::init();
+            const QByteArray idBytes = id.toUtf8();
+            bool inList = false;
+            std::unique_ptr<Mlt::Properties> filterList(repo->filters());
+            for (int i = 0; filterList && i < filterList->count(); ++i) {
+                if (idBytes == filterList->get_name(i)) {
+                    inList = true;
+                }
+            }
+            std::unique_ptr<Mlt::Properties> md(repo->metadata(mlt_service_filter_type, idBytes.constData()));
+            qWarning() << "SELFTEST meta" << id << "inFilterList" << inList << "metadata" << (md && md->is_valid())
+                       << "title" << (md && md->is_valid() ? md->get("title") : "-") << "identifier" << (md && md->is_valid() ? md->get("identifier") : "-")
+                       << "version" << (md && md->is_valid() ? md->get("version") : "-");
+            continue;
+        }
+        if (!line.startsWith(QLatin1String("av:"))) {
+            mltFilters << line;
+            continue;
+        }
+        const QString name = line.mid(3).trimmed();
+        const AVFilter *f = getByName ? getByName(name.toUtf8().constData()) : nullptr;
+        if (!f) {
+            qWarning() << "SELFTEST av" << name << "NOT IN libavfilter";
+            continue;
+        }
+        qWarning() << "SELFTEST av" << name << "in" << padCount(f, 0) << "out" << padCount(f, 1) << "inputs ptr" << (const void *) f->inputs << "outputs ptr"
+                   << (const void *) f->outputs << "flags" << f->flags
+                   << "type_in" << (f->inputs ? padType(f->inputs, 0) : -9) << "type_out" << (f->outputs ? padType(f->outputs, 0) : -9);
+    }
+    auto render = [&](const QString &name, const QString &filter) {
+        Mlt::Profile profile(QStringLiteral("atsc_1080p_30").toUtf8().constData());
+        Mlt::Producer producer(profile, "frei0r.test_pat_B");
+        if (!producer.is_valid()) {
+            producer = Mlt::Producer(profile, "color:#3060c0");
+        }
+        QString status = QStringLiteral("producer=%1").arg(producer.is_valid());
+        if (!filter.isEmpty()) {
+            Mlt::Filter f(profile, filter.toUtf8().constData());
+            status += QStringLiteral(" filter(%1)=%2").arg(filter).arg(f.is_valid());
+            if (f.is_valid()) {
+                producer.attach(f);
+            }
+        }
+        const QString out = dir + name + QStringLiteral(".png");
+        QFile::remove(out);
+        Mlt::Consumer consumer(profile, "avformat", out.toUtf8().constData());
+        consumer.set("vcodec", "png");
+        consumer.set("f", "image2");
+        consumer.set("frames", 1);
+        consumer.set("real_time", -1);
+        consumer.set("terminate_on_pause", 1);
+        consumer.connect(producer);
+        producer.seek(5);
+        consumer.run();
+        status += QStringLiteral(" file=%1").arg(QFileInfo::exists(out) ? QFileInfo(out).size() : -1);
+        qWarning() << "SELFTEST" << name << status;
+    };
+    render(QStringLiteral("selftest_plain"), QString());
+    for (const QString &filter : mltFilters) {
+        render(QStringLiteral("selftest_") + QString(filter.trimmed()).replace(QLatin1Char('.'), QLatin1Char('_')), filter.trimmed());
+    }
+}
